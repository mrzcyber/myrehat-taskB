# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
NEXT_PUBLIC_SERVER_URL=

# OpenRouter key for the WAHA concierge webhook (F2). Optional so the image builds without it.
# @optional
OPENROUTER_API_KEY=

# Any OpenRouter `:free` model id.
# @optional
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# When set, POST /api/webhooks/waha requires a matching `X-Api-Key` header.
# @optional
WAHA_WEBHOOK_SECRET=
